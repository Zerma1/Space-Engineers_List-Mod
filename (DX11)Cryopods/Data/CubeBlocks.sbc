<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>

    <Definition xsi:type="MyObjectBuilder_CryoChamberDefinition">
      <Id>
        <TypeId>CryoChamber</TypeId>
        <SubtypeId>DB_cryopodfunctionalsmall</SubtypeId>
      </Id>
      <DisplayName>Cryogenic Pod</DisplayName>
      <Icon>Textures\Darth_Biomech\gui\cryopod_solo.dds</Icon>
      <CubeSize>Small</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size>
        <X>3</X>
        <Y>4</Y>
        <Z>5</Z>
      </Size>
      <ModelOffset>
        <X>0</X>
        <Y>0.25</Y>
        <Z>0</Z>
      </ModelOffset>
      <Model>Models\Darth_Biomech\cryopod_solo.mwm</Model>  
      <CharacterAnimation>CryopodPostureSolo</CharacterAnimation>    
      <Components>
        <Component Subtype="InteriorPlate" Count="10" />
        <Component Subtype="Construction" Count="10" />
        <Component Subtype="Motor" Count="8" />
        <Component Subtype="Computer" Count="12" />
        <Component Subtype="BulletproofGlass" Count="20" />
        <Component Subtype="Medical" Count="10" />
        <Component Subtype="InteriorPlate" Count="10" />
      </Components>
      <CriticalComponent Subtype="Medical" Index="0" />
      <MountPoints>
        <MountPoint Side="Back" StartX="0" StartY="0" EndX="3" EndY="4" />
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="3" EndY="5" />
      </MountPoints>
      <PhysicsOption>Box</PhysicsOption>
      <BuildProgressModels>
        <Model BuildPercentUpperBound="1.00" File="Models\Darth_Biomech\cryopod_solo_progress_01.mwm"/>
      </BuildProgressModels>
      <MirroringZ>Y</MirroringZ>
      <MirroringY>Z</MirroringY>
      <BlockPairName>DB_cryopodfunctional</BlockPairName>
      <OverlayTexture>Textures\Darth_Biomech\cryopod_overlay.dds</OverlayTexture>
      <BuildTimeSeconds>15</BuildTimeSeconds>
      <EnableFirstPerson>true</EnableFirstPerson>
      <IsPressurized>true</IsPressurized>
      <OxygenCapacity>1</OxygenCapacity>
      <EdgeType>Light</EdgeType>
      <DamageEffectId>214</DamageEffectId>
      <ResourceSinkGroup>Utility</ResourceSinkGroup>
      <IdlePowerConsumption>0.00003</IdlePowerConsumption>
      <OutsideSound>BlockCryoOut</OutsideSound>
      <InsideSound>BlockCryoIn</InsideSound>
      <PrimarySound>BlockCockpitSm</PrimarySound>
      <DamagedSound>ParticleElectrical</DamagedSound>
      <PCU>15</PCU>
    </Definition>

